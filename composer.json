{
    "name": "camada/camada",
    "description": "camada SDK for PHP: inline enforcement of your snapshot (ordered custom rules, then allow, block, challenge), first-party beacon and proof-of-work challenge, batched event shipping. Works with $_SERVER + php://input + header() alone; Laravel middleware included.",
    "type": "library",
    "homepage": "https://www.camada.app/docs/php",
    "license": "MIT",
    "keywords": [
        "camada",
        "bot-detection",
        "bot-protection",
        "credential-stuffing",
        "account-takeover",
        "rate-limiting",
        "proof-of-work",
        "ai-scraper",
        "security",
        "middleware",
        "laravel",
        "php"
    ],
    "support": {
        "docs": "https://www.camada.app/docs/php",
        "issues": "https://github.com/camada-app/camada-php/issues",
        "source": "https://github.com/camada-app/camada-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11 || ^12",
        "phpstan/phpstan": "2.2.16",
        "friendsofphp/php-cs-fixer": "^3.64",
        "illuminate/http": "^10 || ^11 || ^12"
    },
    "autoload": {
        "psr-4": {
            "Camada\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Camada\\Tests\\": "tests/"
        },
        "files": ["tests/MidLoad.php"]
    },
    "scripts": {
        "lint": "phpstan analyse --level 8 --memory-limit 512M src tests",
        "fmt": "php-cs-fixer fix --dry-run --diff",
        "fmt-fix": "php-cs-fixer fix",
        "test": "phpunit",
        "check": [
            "@lint",
            "@fmt",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable"
}
